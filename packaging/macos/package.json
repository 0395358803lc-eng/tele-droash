{
  "name": "telegram-checker-macos",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "description": "macOS desktop packaging shell for Telegram Checker",
  "author": "Telegram Checker",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "2.3.3",
    "pino-pretty": "13.1.3",
    "thread-stream": "3.1.0"
  },
  "build": {
    "appId": "com.telegramchecker.desktop",
    "productName": "Telegram Checker",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../artifacts/telegram-checker/dist/public",
        "to": "ui"
      },
      {
        "from": "../../release/python-macos/telegram-engine",
        "to": "bin/telegram-engine"
      }
    ],
    "directories": {
      "output": "../../release/macos"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Telegram-Checker-${version}-macOS-${arch}.${ext}"
    }
  }
}
