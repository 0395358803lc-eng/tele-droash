{
  "name": "telegram-checker-windows",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "description": "Windows desktop packaging shell for Telegram Checker",
  "author": "Telegram Checker",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "2.3.3",
    "pino-pretty": "13.1.3",
    "thread-stream": "3.1.0"
  },
  "build": {
    "appId": "com.telegramchecker.desktop",
    "productName": "Telegram Checker",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../artifacts/telegram-checker/dist/public",
        "to": "ui"
      },
      {
        "from": "../../release/python/telegram-engine.exe",
        "to": "bin/telegram-engine.exe"
      }
    ],
    "directories": {
      "output": "../../release/windows"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Telegram-Checker-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Checker"
    },
    "portable": {
      "artifactName": "Telegram-Checker-Portable-${version}-${arch}.${ext}"
    }
  }
}
