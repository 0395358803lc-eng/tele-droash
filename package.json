{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-dev.ps1",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-check.ps1",
    "desktop:backup": "python ./scripts/backup_sqlite.py",
    "desktop:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-setup.ps1",
    "desktop:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-start.ps1",
    "desktop:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-audit.ps1",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows-package.ps1",
    "desktop:package:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke-windows-package.ps1",
    "desktop:python-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-python-engine.ps1",
    "desktop:macos:check": "bash ./scripts/macos-check.sh",
    "desktop:package:macos": "bash ./scripts/build-macos-package.sh",
    "desktop:python-engine:macos": "bash ./scripts/build-python-engine-macos.sh"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
