API_ID=
API_HASH=
PHONE_NUMBER=

DATABASE_PATH=data/checker.db

DEFAULT_PHONE_REGION=VN

MAX_ATTEMPTS=3

BASE_RETRY_DELAY_SECONDS=30

MAX_RETRY_DELAY_SECONDS=3600

MIN_REQUEST_INTERVAL_SECONDS=

AUTO_RESUME=false

WORKER_LEASE_SECONDS=60

WORKER_STALE_TIMEOUT_SECONDS=30

# Consecutive lease-renew (heartbeat) failures before a worker fails closed.
# Total retry window must not exceed the lease expiry; keep it modest.
LEASE_RENEW_FAILURE_LIMIT=3

# Extra wait after a lease expires before a new worker may take it over.
# Pure concurrency safety (reduces mid-operation takeover), NOT a rate-limit
# workaround. Set to 0 to disable.
LEASE_TAKEOVER_GRACE_SECONDS=0
IN_FLIGHT_RECOVERY_GRACE_SECONDS=60

LOG_LEVEL=INFO
